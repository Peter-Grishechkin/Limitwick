#!/bin/bash
# A CLI that dies on launch must not keep the client polling a hung-up PTY until the timeout.
[[ "${FAKE_CLAUDE_SCENARIO:-}" == 'exit' ]] && exit 0
# `-p /usage --output-format stream-json`: limits as data; other scenarios behave like a CLI without it.
if [[ "${1:-}" == '-p' ]]; then
  [[ -n "${FAKE_CLAUDE_LOG:-}" ]] && echo json >> "$FAKE_CLAUDE_LOG"
  limits='[{"kind":"session","group":"session","percent":30,"resets_at":"2026-12-31T05:00:00.364550+00:00","scope":null,"severity":"normal","is_active":true},{"kind":"weekly_all","group":"weekly","percent":45,"resets_at":"2027-01-03T08:00:00.364570+00:00","scope":null,"severity":"normal","is_active":false},{"kind":"weekly_scoped","group":"weekly","percent":0,"resets_at":null,"scope":{"model":{"display_name":"Fable"},"surface":null},"severity":"normal","is_active":false}]'
  case "${FAKE_CLAUDE_SCENARIO:-}" in
    json) ;;
    json-saved) limits=null ;;
    json-model)
      printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"Here is your usage."}]}}' '{"type":"result","subtype":"success","is_error":false,"num_turns":1,"total_cost_usd":0.01}'
      exit 0 ;;
    *) exit 1 ;;
  esac
  printf '%s\n' '{"type":"system","subtype":"init","claude_code_version":"2.1.318"}' \
    '{"type":"assistant","message":{"content":[{"type":"text","text":"Current session: 30% used"}]},"usage_report":{"session":{"total_cost_usd":0},"rate_limits":{"limits":'"$limits"',"extra_usage":null}}}' \
    '{"type":"result","subtype":"success","is_error":false,"num_turns":0,"total_cost_usd":0}'
  exit 0
fi
printf 'Claude Code ready\r\n'
if [[ "${FAKE_CLAUDE_SCENARIO:-}" == 'login' ]]; then
  printf 'Not authenticated. Run /login\r\n'
  exit 0
fi
if [[ "${FAKE_CLAUDE_SCENARIO:-}" == 'trust' ]]; then
  # Claude Code can reset the selection to "No, exit" right after the first draw, losing an early arrow key.
  dialog() { printf '\033[2J\033[HQuick safety check\r\n%s No, exit\r\n%s Yes, I trust this folder\r\n' "$1" "$2"; }
  stty -icanon -echo
  dialog '❯' ' '
  downs=0
  while IFS= read -rsn1 key; do
    if [[ "$key" == $'\033' ]]; then
      IFS= read -rsn2 rest
      [[ "$rest" == '[B' ]] && downs=$((downs + 1))
      (( downs == 2 )) && dialog ' ' '❯'
    elif [[ "$key" == $'\r' || -z "$key" ]]; then
      (( downs >= 2 )) || exit 1
      break
    fi
  done
  stty icanon echo
  printf '\033[2J\033[HClaude Code ready\r\n'
fi
while IFS= read -r input; do
  if [[ "$input" == '/usage' ]]; then
    if [[ "${FAKE_CLAUDE_SCENARIO:-}" == 'error' ]]; then
      printf '\033[2J\033[HFailed to load usage\r\n'
      continue
    fi
    bars='\033[2J\033[HCurrent session\r\n  23%% used\r\n  Resets 11:59pm (UTC)\r\n\r\nCurrent week (all models)\r\n  41%% used\r\n  Resets Dec 3, 11:59pm (UTC)\r\n'
    if [[ "${FAKE_CLAUDE_SCENARIO:-}" == 'lastknown' ]]; then
      printf "$bars"'\r\nShowing last-known usage as of 12m ago (rate limited until 3:15pm)\r\n'
      continue
    fi
    if [[ "${FAKE_CLAUDE_SCENARIO:-}" == 'slow' ]]; then
      # Claude Code draws the saved bars with "Refreshing…" at once and replaces that line when the request ends.
      printf "$bars"'\r\nRefreshing\xe2\x80\xa6'
      sleep 2
      printf '\r\033[2KShowing last-known usage as of 2m ago (could not refresh)\r\n'
      continue
    fi
    printf "$bars"
  fi
done
