#!/bin/bash
if [[ "$FAKE_SCENARIO" == timeout ]]; then
  if [[ -n "${FAKE_PID_FILE:-}" ]]; then printf "%s" "$$" > "$FAKE_PID_FILE"; fi
  exec /bin/sleep 10
fi
if [[ "$FAKE_SCENARIO" == late ]]; then /bin/sleep 0.4; fi
if [[ "$FAKE_SCENARIO" == truncated ]]; then printf '{"id":1'; exit 0; fi
if [[ "$FAKE_SCENARIO" == large ]]; then /usr/bin/head -c 1100000 /dev/zero | /usr/bin/tr '\0' x; exit 0; fi
IFS= read -r line
printf '%s\n' '{"id":1,"result":{}}'
IFS= read -r line
IFS= read -r line
if [[ "$FAKE_SCENARIO" == auth ]]; then
  printf '%s\n' '{"id":2,"error":{"message":"Not authenticated"}}'
else
  printf '%s\n' '{"id":2,"result":{"rateLimits":{"primary":{"windowDurationMins":300,"usedPercent":25},"secondary":{"windowDurationMins":10080,"usedPercent":80}}}}'
fi
